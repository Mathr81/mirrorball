# apps/api
PORT=8787
DB_PATH=./data/cache.db

# Cookie sp_dc d'un compte Spotify Premium, utilisé UNIQUEMENT côté serveur
# pour fabriquer un token client web-player (paroles synchronisées via Spicy
# Lyrics). Jamais transmis au navigateur. Optionnel : sans lui, le service
# démarre normalement en mode dégradé (KPoe + LRCLIB, paroles non
# synchronisées côté Spicy).
SP_DC=

# Secret TOTP (hex) + version attendue par l'endpoint de minting du token
# web-player (apps/api/src/providers/spicy/web-player-token.ts). Mécanisme
# reverse-engineered, non fourni ici : le secret tourne côté Spotify et doit
# être obtenu/mis à jour séparément. Sans ces deux valeurs (ou sp_dc), Spicy
# fonctionne quand même mais sans paroles synchronisées.
SPICY_TOTP_SECRET_HEX=
SPICY_TOTP_VERSION=

# Origin/Referer envoyés à l'API Spicy Lyrics (volontairement les nôtres, pas
# ceux du client officiel Spotify, cf. providers/spicy/client.ts) ET origine
# autorisée en CORS pour /api/*. Doit correspondre à l'URL réelle du front
# (VITE_API_BASE_URL ci-dessous pointe dans l'autre sens, vers l'API).
APP_ORIGIN=http://localhost:5173

# User-Agent envoyés aux amonts tiers, pour s'identifier honnêtement.
KPOE_USER_AGENT=mirrorball/0.1 (personal lyrics reader)
LRCLIB_USER_AGENT=mirrorball/0.1 (+personal use; https://github.com/mathr81/mirrorball)
SPICY_USER_AGENT=mirrorball/0.1 (personal lyrics reader)

# apps/web (Vite — préfixe VITE_ obligatoire pour être exposé au bundle)
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URI=http://localhost:5173/callback
VITE_API_BASE_URL=http://localhost:8787
